# Flowbie WP secrets — copy to .env and fill in ( .env is gitignored )
#
# Or run: npm run embed:flowbie-wp-secrets (copies from repo root .env before deploy)

# OpenRouter — AI generation, chat demo, editor wands
FLOWBIE_WP_OPENROUTER_API_KEY=

# DataForSEO — keyword research (login + API password from dataforseo.com)
FLOWBIE_WP_DATAFORSEO_LOGIN=
FLOWBIE_WP_DATAFORSEO_PASSWORD=

# AgentMail — Flo inbox and per-site email (keys from console.agentmail.to)
FLOWBIE_WP_AGENTMAIL_API_KEY=
FLOWBIE_WP_AGENTMAIL_INBOX=

# Semrush — optional SEO research
FLOWBIE_WP_SEMRUSH_API_KEY=

# Chekkit — Events webhook URL (Settings → Connections → Events webhook in Chekkit)
# Default hub: https://flowbie.ca/webhook (also set in Chat → General unless overridden here)
FLOWBIE_WP_CHEKKIT_WEBHOOK_URL=
